# Quarkus reads .env from the backend directory. Never commit real credentials.
HUB_WEB_ORIGIN=http://localhost:3001
# Optional first administrator. Existing accounts are never silently promoted.
HUB_ADMIN_EMAIL=
HUB_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production database and HTTPS:
DB_URL=jdbc:postgresql://localhost:5432/topology_hub
DB_USER=topology
DB_PASSWORD=
